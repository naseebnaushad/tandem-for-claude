# All optional, mainly for testing. Leave unset to use the defaults shown.

# App folder: profiles, settings, backups, state, log. Default: ~/.claude-profile
CLAUDE_PROFILE_HOME=

# Claude desktop's own data folder (holds claude-code-sessions).
# Default: macOS ~/Library/Application Support/Claude, Windows %APPDATA%\Claude, Linux ~/.config/Claude
CLAUDE_PROFILE_APP_DATA=

# Claude Code's shared folder that terminal profiles link to. Default: ~/.claude
CLAUDE_PROFILE_CLAUDE_DIR=

# Claude Code transcripts folder. Default: <CLAUDE_PROFILE_CLAUDE_DIR>/projects
CLAUDE_PROFILE_PROJECTS=
